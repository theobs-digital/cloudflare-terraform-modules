# The API token comes from the CLOUDFLARE_API_TOKEN environment variable.
provider "cloudflare" {}

locals {
  # The objects as they are in Cloudflare, under keys of your choice.
  tunnels = {
    # Created in the dashboard: configured from Cloudflare.
    office = { name = "office", config_src = "cloudflare" }
  }

  # Under the key of their tunnel.
  tunnel_configs = {
    office = {
      tunnel_id = module.networks.tunnel_cloudflared_ids["office"]
      config = {
        ingress = [
          { hostname = "wiki.example.com", service = "http://localhost:8080" },
          { service = "http_status:404" },
        ]
      }
    }
  }

  virtual_networks = {
    # Every account has one. Write the comment Cloudflare returns.
    default = {
      name               = "default"
      comment            = "This network was autogenerated because this account lacked a default one"
      is_default_network = true
    }
  }

  # With the keys of their tunnel or WARP Connector, and of their virtual
  # network. Cloudflare returns an empty comment for a route without one.
  routes = {
    office_lan     = { network = "192.168.1.0/24", tunnel = "office", virtual_network = "default", comment = "" }
    datacenter_lan = { network = "10.3.0.0/24", tunnel = "datacenter", virtual_network = "default", comment = "" }
  }

  hostname_routes = {
    # Left out, an empty comment would be sent as null, which Cloudflare refuses.
    intranet = { hostname = "intranet.corp.example.com", tunnel_id = module.networks.tunnel_cloudflared_ids["office"], comment = "" }
  }

  warp_connectors = {
    # An HA connector returns ha = true: write it, or the plan sets it to false.
    datacenter = { name = "datacenter", ha = true }
  }
}

module "networks" {
  source = "../.."

  account_id = var.account_id

  tunnel_cloudflareds                 = local.tunnels
  tunnel_cloudflared_configs          = local.tunnel_configs
  tunnel_cloudflared_virtual_networks = local.virtual_networks
  network_hostname_routes             = local.hostname_routes
  tunnel_warp_connectors              = local.warp_connectors

  tunnel_cloudflared_routes = {
    for key, route in local.routes : key => {
      network            = route.network
      tunnel_id          = merge(module.networks.tunnel_cloudflared_ids, module.networks.tunnel_warp_connector_ids)[route.tunnel]
      virtual_network_id = module.networks.tunnel_cloudflared_virtual_network_ids[route.virtual_network]
      comment            = route.comment
    }
  }
}

# Cloudflare keeps deleted objects under their names: leave them out.
data "cloudflare_zero_trust_tunnel_cloudflareds" "existing" {
  account_id = var.account_id
  is_deleted = false
}

data "cloudflare_zero_trust_tunnel_cloudflared_virtual_networks" "existing" {
  account_id = var.account_id
  is_deleted = false
}

data "cloudflare_zero_trust_tunnel_cloudflared_routes" "existing" {
  account_id = var.account_id
  is_deleted = false
}

data "cloudflare_zero_trust_network_hostname_routes" "existing" {
  account_id = var.account_id
  is_deleted = false
}

# The existing object each entry stands for: the same name, network or
# hostname. one() fails on two matches. One local per kind, or Terraform
# reports a cycle: routes refer to tunnels and virtual networks.
locals {
  existing_tunnel_ids = {
    for key, tunnel in local.tunnels : key => one([
      for existing in data.cloudflare_zero_trust_tunnel_cloudflareds.existing.result : existing.id
      if existing.name == tunnel.name
    ])
  }

  existing_virtual_network_ids = {
    for key, network in local.virtual_networks : key => one([
      for existing in data.cloudflare_zero_trust_tunnel_cloudflared_virtual_networks.existing.result : existing.id
      if existing.name == network.name
    ])
  }

  # A CIDR is routed once per virtual network.
  existing_route_ids = {
    for key, route in local.routes : key => one([
      for existing in data.cloudflare_zero_trust_tunnel_cloudflared_routes.existing.result : existing.id
      if existing.network == route.network && existing.virtual_network_id == local.existing_virtual_network_ids[route.virtual_network]
    ])
  }

  existing_hostname_route_ids = {
    for key, route in local.hostname_routes : key => one([
      for existing in data.cloudflare_zero_trust_network_hostname_routes.existing.result : existing.id
      if existing.hostname == route.hostname
    ])
  }
}

# An entry that matches no existing object is not imported: the plan creates
# it, and the unmatched output lists it.
import {
  for_each = { for key, id in local.existing_tunnel_ids : key => id if id != null }
  to       = module.networks.cloudflare_zero_trust_tunnel_cloudflared.this[each.key]
  id       = "${var.account_id}/${each.value}"
}

# A configuration's ID is its tunnel's.
import {
  for_each = { for key in keys(local.tunnel_configs) : key => local.existing_tunnel_ids[key] if local.existing_tunnel_ids[key] != null }
  to       = module.networks.cloudflare_zero_trust_tunnel_cloudflared_config.this[each.key]
  id       = "${var.account_id}/${each.value}"
}

import {
  for_each = { for key, id in local.existing_virtual_network_ids : key => id if id != null }
  to       = module.networks.cloudflare_zero_trust_tunnel_cloudflared_virtual_network.this[each.key]
  id       = "${var.account_id}/${each.value}"
}

import {
  for_each = { for key, id in local.existing_route_ids : key => id if id != null }
  to       = module.networks.cloudflare_zero_trust_tunnel_cloudflared_route.this[each.key]
  id       = "${var.account_id}/${each.value}"
}

import {
  for_each = { for key, id in local.existing_hostname_route_ids : key => id if id != null }
  to       = module.networks.cloudflare_zero_trust_network_hostname_route.this[each.key]
  id       = "${var.account_id}/${each.value}"
}

# By ID: the data sources of WARP Connectors fail in provider 5.28.0.
import {
  for_each = var.warp_connector_ids
  to       = module.networks.cloudflare_zero_trust_tunnel_warp_connector.this[each.key]
  id       = "${var.account_id}/${each.value}"
}
